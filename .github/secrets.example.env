# Copy values into GitHub → Settings → Secrets and variables → Actions
# Do NOT commit real credentials.

SSH_HOST=your-server-ip-or-hostname
SSH_USERNAME=solexpr1
SSH_PASSWORD=your-cpanel-or-ssh-password
SSH_PORT=22

# Absolute paths on cPanel (trailing slash recommended)
BE_REMOTE_PATH=/home/solexpr1/api.solexpress.vn/
FE_REMOTE_PATH=/home/solexpr1/portal.solexpress.vn/

# From error log earlier: /home/solexpr1/nodevenv/api.solexpress.vn/18
NODE_VENV_PATH=/home/solexpr1/nodevenv/api.solexpress.vn/18

REACT_APP_API_URL=https://api.solexpress.vn

# Telegram notify (create via @BotFather; add bot to group as admin)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
